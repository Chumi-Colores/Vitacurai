cat > .dockerignore << 'EOF'
# Git
.git/
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Desarrollo
.vscode/
.idea/
*.log

# Tests y ejemplos
test_*.py
**/test_*
area/
outdir/
*.jpg
*.png
*.jpeg
*.gif

# Documentación pesada
*.md
docs/

# Archivos temporales
*.tmp
*.temp
.DS_Store

# Node modules si existen
node_modules/

# Archivos de configuración local
.env
.env.local

# Logs
logs/
*.log
EOF